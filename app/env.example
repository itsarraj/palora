# Copy to .env (Expo reads EXPO_PUBLIC_* at bundle time)
EXPO_PUBLIC_BFF_API_URL=http://localhost:8000
EXPO_PUBLIC_BFF_API_VERSION=v1
# adb = Metro/BFF reached through `adb reverse` on 127.0.0.1 (see package.json scripts)
EXPO_PUBLIC_DEV_TRANSPORT=adb
EXPO_PUBLIC_USE_LOCAL_BFF=1
# Expo project id, needed for push tokens in a dev-client build
# EAS_PROJECT_ID=
# Android push also needs Firebase: put google-services.json in app/ or set
# GOOGLE_SERVICES_JSON=/path/to/google-services.json, then rebuild the native app.
