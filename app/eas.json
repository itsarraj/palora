{
  "cli": {
    "version": ">= 16"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BFF_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_USE_LOCAL_BFF": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BFF_API_URL": "https://palora.kraftisium.xyz",
        "EXPO_PUBLIC_USE_LOCAL_BFF": "0"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BFF_API_URL": "https://palora.kraftisium.xyz",
        "EXPO_PUBLIC_BFF_API_VERSION": "v1",
        "EXPO_PUBLIC_USE_LOCAL_BFF": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
