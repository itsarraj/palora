{
  "name": "palora",
  "main": "expo-router/entry",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android:reverse:dev": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8000 tcp:8000 && adb reverse tcp:8001 tcp:8001",
    "dev:android-adb": "bun run android:reverse:dev && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 EXPO_PUBLIC_DEV_TRANSPORT=adb expo start --dev-client",
    "dev:android-adb:clear": "bun run android:reverse:dev && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 EXPO_PUBLIC_DEV_TRANSPORT=adb expo start --dev-client --clear",
    "android:open": "bun run android:reverse:dev && adb shell am start -a android.intent.action.VIEW -d 'exp+palora://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081'",
    "android:clean": "cd android && ./gradlew clean",
    "android:install:adb": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --device --no-bundler",
    "android:rebuild": "test -d android || expo prebuild --platform android; expo run:android --device",
    "android:logcat": "adb logcat *:S ReactNative:V ReactNativeJS:V Expo:V",
    "lint": "tsc --noEmit",
    "web": "expo start --web",
    "android:release": "cd android && ./gradlew :app:assembleRelease",
    "android:bundle": "cd android && ./gradlew :app:bundleRelease",
    "keystore": "bash scripts/make-keystore.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~56.0.22",
    "expo-auth-session": "~56.0.19",
    "expo-constants": "~56.0.26",
    "expo-dev-client": "~56.0.27",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.18",
    "expo-location": "~56.0.26",
    "expo-notifications": "~56.0.25",
    "expo-router": "~56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "^1.22.5",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
