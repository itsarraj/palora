DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/auth_kit

BFF__APPLICATION_PORT=8000
BFF__APPLICATION_HOST=127.0.0.1

BFF__DATABASE__HOST=127.0.0.1
BFF__DATABASE__PORT=5432
BFF__DATABASE__USERNAME=postgres
BFF__DATABASE__PASSWORD=postgres
BFF__DATABASE__DATABASE_NAME=auth_kit

BFF__REDIS__HOST=127.0.0.1
BFF__REDIS__PORT=6379

# openssl rand -hex 32
BFF__JWT__SECRET=change-this-dev-secret-to-something-random
BFF__JWT__ACCESS_TOKEN_EXPIRATION_HOURS=24
BFF__JWT__REFRESH_TOKEN_EXPIRATION_DAYS=30

# Resend (https://resend.com). Empty = emails are logged, not sent.
BFF__EMAIL__API_KEY=
BFF__EMAIL__FROM_EMAIL=noreply@palora.app
BFF__EMAIL__FROM_NAME=Palora
# Public URL of this BFF (used for verify links and /media photo URLs)
BFF__EMAIL__BASE_URL=http://localhost:8000
BFF__EMAIL__FRONTEND_BASE_URL=http://localhost:8081

BFF__AUTH__REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth (Web client). Copy real values into .env — never commit them.
BFF__OAUTH__GOOGLE__CLIENT_ID=your-client-id.apps.googleusercontent.com
BFF__OAUTH__GOOGLE__CLIENT_SECRET=GOCSPX-your-client-secret
BFF__OAUTH__GOOGLE__REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Cloudflare Turnstile — leave unset for the mobile app (the app cannot render the widget)
# BFF__TURNSTILE__SECRET_KEY=
# BFF__TURNSTILE__HOSTNAMES=localhost,127.0.0.1

# Photo storage
BFF__STORAGE__DIR=uploads
# BFF__STORAGE__PUBLIC_BASE_URL=https://api.palora.app/media
BFF__STORAGE__MAX_UPLOAD_MB=8
# RustFS / S3 object storage (unset = local disk fallback under BFF__STORAGE__DIR)
# BFF__STORAGE__ENDPOINT=http://127.0.0.1:9000
# BFF__STORAGE__BUCKET=palora-media
# BFF__STORAGE__ACCESS_KEY_ID=rustfsadmin
# BFF__STORAGE__SECRET_ACCESS_KEY=rustfsadmin
# BFF__STORAGE__REGION=us-east-1

# SMS OTP provider: dev | msg91 | twilio  (dev logs the code and accepts 123456)
BFF__SMS__PROVIDER=dev
# BFF__SMS__MSG91_AUTH_KEY=
# BFF__SMS__MSG91_TEMPLATE_ID=
# BFF__SMS__TWILIO_ACCOUNT_SID=
# BFF__SMS__TWILIO_AUTH_TOKEN=
# BFF__SMS__TWILIO_FROM=+1xxxxxxxxxx

# Expo push notifications
BFF__PUSH__ENABLED=true
# BFF__PUSH__EXPO_ACCESS_TOKEN=

# Rate limiting (per minute, per IP or per token)
BFF__RATE_LIMIT__ENABLED=true
BFF__RATE_LIMIT__AUTH_PER_MINUTE=10
BFF__RATE_LIMIT__API_PER_MINUTE=240

# Legal pages
BFF__LEGAL__APP_NAME=Palora
BFF__LEGAL__SUPPORT_EMAIL=support@palora.app
BFF__LEGAL__COMPANY=Kraftisium
