# Copy to bff/.env.prod on the VPS (chmod 600). Never commit the real file.
# Compose interpolation (postgres) + BFF config both read this file.

POSTGRES_USER=palora
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24
POSTGRES_DB=palora

# openssl rand -hex 32
BFF__JWT__SECRET=change-me-replace-with-openssl-rand-hex-32
BFF__JWT__ACCESS_TOKEN_EXPIRATION_HOURS=24
BFF__JWT__REFRESH_TOKEN_EXPIRATION_DAYS=30

# Public URL that nginx exposes for this BFF (used for links and photo URLs)
BFF__EMAIL__BASE_URL=https://palora.kraftisium.xyz
BFF__EMAIL__FRONTEND_BASE_URL=https://palora.kraftisium.xyz
BFF__EMAIL__API_KEY=re_xxx
BFF__EMAIL__FROM_EMAIL=noreply@palora.app
BFF__EMAIL__FROM_NAME=Palora
BFF__AUTH__REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth (Web client). Redirect must match the Google console exactly.
BFF__OAUTH__GOOGLE__CLIENT_ID=
BFF__OAUTH__GOOGLE__CLIENT_SECRET=
BFF__OAUTH__GOOGLE__REDIRECT_URI=https://palora.kraftisium.xyz/api/v1/auth/google/callback

# Turnstile must stay OFF for the mobile app (it cannot render the widget).
# BFF__TURNSTILE__SECRET_KEY=

BFF__STORAGE__PUBLIC_BASE_URL=https://palora.kraftisium.xyz/media
BFF__STORAGE__MAX_UPLOAD_MB=8

# SMS: msg91 (India) or twilio. dev = log only, accepts 123456.
BFF__SMS__PROVIDER=msg91
BFF__SMS__MSG91_AUTH_KEY=
BFF__SMS__MSG91_TEMPLATE_ID=
# BFF__SMS__PROVIDER=twilio
# BFF__SMS__TWILIO_ACCOUNT_SID=
# BFF__SMS__TWILIO_AUTH_TOKEN=
# BFF__SMS__TWILIO_FROM=

BFF__PUSH__ENABLED=true
# Optional: Expo access token for the push API (needed if "Enhanced push security" is on)
# BFF__PUSH__EXPO_ACCESS_TOKEN=

BFF__RATE_LIMIT__ENABLED=true
BFF__RATE_LIMIT__AUTH_PER_MINUTE=10
BFF__RATE_LIMIT__API_PER_MINUTE=240

BFF__LEGAL__APP_NAME=Palora
BFF__LEGAL__SUPPORT_EMAIL=support@palora.app
BFF__LEGAL__COMPANY=Kraftisium
